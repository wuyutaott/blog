#!/usr/bin/env bash
# mediactl — 博客多媒体资产管理 CLI
#
# 把"重命名 + 压缩 + rsync 上 VPS + 验证 + 输出 markdown 引用"5 步压成 1 行
# 无状态脚本：跑挂了不影响已上传资产，配套文件见 docs/2026-05-06-博客多媒体资产管理规则.md
#
# 用法见 mediactl --help

set -euo pipefail

# ============================================================================
# 1. 定位项目根 + 加载 .env
# ============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "${SCRIPT_DIR}")"

if [ ! -f "${PROJECT_ROOT}/.env" ]; then
  echo "❌ Error: ${PROJECT_ROOT}/.env not found" >&2
  echo "请先创建 .env（参考 .env.example）" >&2
  exit 1
fi

set -a
# shellcheck disable=SC1091
source "${PROJECT_ROOT}/.env"
set +a

# 默认值（.env 没设就用这些）
LOCAL_MEDIA_DIR="${LOCAL_MEDIA_DIR:-${HOME}/blog-media}"
VPS_CDN_DIR="${VPS_CDN_DIR:-/var/www/cdn}"
DEFAULT_MAX_WIDTH="${DEFAULT_MAX_WIDTH:-2000}"

# 必需变量校验
: "${VPS_HOST:?VPS_HOST not set in .env}"
: "${DOMAIN:?DOMAIN not set in .env}"

# ============================================================================
# 2. 工具函数
# ============================================================================

_red()    { printf "\033[31m%s\033[0m\n" "$*"; }
_green()  { printf "\033[32m%s\033[0m\n" "$*"; }
_yellow() { printf "\033[33m%s\033[0m\n" "$*"; }
_blue()   { printf "\033[34m%s\033[0m\n" "$*"; }

_die() {
  _red "❌ $*"
  exit 1
}

# 当前年/月
_year()  { date +%Y; }
_month() { date +%m; }

# 检查工具是否存在
_have() { command -v "$1" >/dev/null 2>&1; }

# 把 URL 复制到 macOS 剪贴板（如果可用）
_copy_to_clipboard() {
  if _have pbcopy; then
    printf "%s" "$1" | pbcopy
    _green "✓ 已复制到剪贴板"
  fi
}

# ============================================================================
# 3. 子命令实现
# ============================================================================

cmd_add() {
  local source_file=""
  local name=""
  local compress=false
  local do_rsync=true
  local year month
  year="$(_year)"
  month="$(_month)"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)        name="$2"; shift 2 ;;
      --compress)    compress=true; shift ;;
      --no-rsync)    do_rsync=false; shift ;;
      --year)        year="$2"; shift 2 ;;
      --month)       month="$2"; shift 2 ;;
      -*)            _die "未知参数: $1" ;;
      *)             source_file="$1"; shift ;;
    esac
  done

  [ -z "$source_file" ] && _die "用法: mediactl add <source-file> [--name X] [--compress]"
  [ ! -f "$source_file" ] && _die "源文件不存在: $source_file"

  # 推导文件名
  local ext="${source_file##*.}"
  ext="$(echo "$ext" | tr '[:upper:]' '[:lower:]')"   # 扩展名小写
  if [ -z "$name" ]; then
    # 没给 --name，用原文件名（去扩展名）
    name="$(basename "$source_file" ".${source_file##*.}")"
    _yellow "⚠️  未指定 --name，用原文件名: $name"
  fi

  # 校验命名规范（小写 + 短横线 + 数字）
  if [[ ! "$name" =~ ^[a-z0-9-]+$ ]]; then
    _die "文件名不符合规范（只允许小写字母/数字/短横线）: $name"
  fi

  local target_dir="${LOCAL_MEDIA_DIR}/${year}/${month}"
  local target_path="${target_dir}/${name}.${ext}"
  local relative_path="${year}/${month}/${name}.${ext}"
  local public_url="https://cdn.${DOMAIN}/${relative_path}"

  # 资产不可变铁律：目标已存在就报错
  if [ -e "$target_path" ]; then
    _die "目标文件已存在（资产不可变原则禁止覆盖）: $target_path
    要换图请用新名字。需要删除请手动 rm 后重新跑。"
  fi

  mkdir -p "$target_dir"

  # 复制 / 压缩
  _blue "→ 复制到 ${target_path}"
  if $compress; then
    if ! _have sips; then
      _yellow "⚠️  sips 不可用（仅 macOS），跳过压缩"
      cp "$source_file" "$target_path"
    else
      cp "$source_file" "$target_path"
      _blue "→ 用 sips 压缩到 ${DEFAULT_MAX_WIDTH}px max"
      sips -Z "${DEFAULT_MAX_WIDTH}" "$target_path" >/dev/null
    fi
  else
    cp "$source_file" "$target_path"
  fi

  local local_size
  local_size="$(du -h "$target_path" | cut -f1)"
  _green "✓ 本地: ${target_path} (${local_size})"

  # rsync 到 VPS
  if $do_rsync; then
    _blue "→ rsync 到 ${VPS_HOST}:${VPS_CDN_DIR}/"
    rsync -az "${LOCAL_MEDIA_DIR}/" "${VPS_HOST}:${VPS_CDN_DIR}/"
    _green "✓ 已同步"

    # 校正 VPS 端权限
    ssh "${VPS_HOST}" "chown -R caddy:caddy ${VPS_CDN_DIR}" 2>/dev/null || true

    # 验证可访问
    _blue "→ 验证 ${public_url}"
    local http_code
    http_code="$(curl -s -o /dev/null -w "%{http_code}" -I "$public_url")"
    if [ "$http_code" = "200" ]; then
      _green "✓ HTTP 200"
    else
      _yellow "⚠️  HTTP ${http_code}（可能 CF 还在传播，过几秒再试）"
    fi
  else
    _yellow "⚠️  跳过 rsync（--no-rsync）"
  fi

  # 输出 markdown 引用
  echo
  _blue "Markdown 引用："
  local md_ref
  case "$ext" in
    mp4|webm|mov)
      md_ref="<video src=\"${public_url}\" controls></video>"
      ;;
    *)
      md_ref="<img src=\"${public_url}\" width=\"800\" />"
      ;;
  esac
  echo "  ${md_ref}"
  _copy_to_clipboard "$md_ref"
}

cmd_sync() {
  _blue "→ rsync ${LOCAL_MEDIA_DIR}/ → ${VPS_HOST}:${VPS_CDN_DIR}/"
  rsync -avz --progress "${LOCAL_MEDIA_DIR}/" "${VPS_HOST}:${VPS_CDN_DIR}/"
  ssh "${VPS_HOST}" "chown -R caddy:caddy ${VPS_CDN_DIR}" 2>/dev/null || true
  _green "✓ 同步完成"
}

cmd_preview() {
  _blue "→ rsync dry-run（仅预览，不传输）"
  rsync -avzn "${LOCAL_MEDIA_DIR}/" "${VPS_HOST}:${VPS_CDN_DIR}/"
}

cmd_prune() {
  _yellow "⚠️  --delete 会把 VPS 上本地没有的文件删除。先 dry-run:"
  rsync -avzn --delete "${LOCAL_MEDIA_DIR}/" "${VPS_HOST}:${VPS_CDN_DIR}/"
  echo
  read -r -p "确认要真跑（带 --delete）？[y/N] " ok
  if [ "$ok" = "y" ] || [ "$ok" = "Y" ]; then
    rsync -avz --delete "${LOCAL_MEDIA_DIR}/" "${VPS_HOST}:${VPS_CDN_DIR}/"
    _green "✓ 已带 --delete 同步"
  else
    _yellow "已取消"
  fi
}

cmd_ls() {
  local subpath="${1:-}"
  local dir="${LOCAL_MEDIA_DIR}/${subpath}"
  if [ -d "$dir" ]; then
    find "$dir" -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" \
      -o -name "*.webp" -o -name "*.gif" -o -name "*.mp4" -o -name "*.mov" \
      -o -name "*.webm" \) | sed "s|${LOCAL_MEDIA_DIR}/||"
  else
    _die "目录不存在: $dir"
  fi
}

cmd_url() {
  local rel="${1:?用法: mediactl url <year/month/file>}"
  local public_url="https://cdn.${DOMAIN}/${rel}"
  echo "$public_url"
  _copy_to_clipboard "$public_url"
}

cmd_help() {
  cat <<'EOF'
mediactl — 博客多媒体资产管理 CLI

用法:
  mediactl add <source-file> [选项]
      把文件加进资产库：重命名 → (可选)压缩 → rsync 到 VPS → 验证 → 输出 markdown
      选项:
        --name <name>      目标文件名（不带扩展名）。默认用源文件名
        --compress         用 sips 压缩到 2000px 宽（仅 macOS）
        --no-rsync         只复制本地，不上传 VPS
        --year YYYY        指定年（默认当前年）
        --month MM         指定月（默认当前月）

  mediactl sync
      把本地 ~/blog-media/ 全量推到 VPS:/var/www/cdn/

  mediactl preview
      看 sync 会传什么（dry-run，不实际传）

  mediactl prune
      带 --delete 的 sync（先 dry-run，二次确认）。会把 VPS 上本地没有的文件删除

  mediactl ls [year/month]
      列出本地资产库的文件

  mediactl url <year/month/file>
      根据相对路径生成公网 URL，复制到剪贴板

环境变量（来自 .env）:
  VPS_HOST           SSH 别名（必需）
  DOMAIN             主域名（必需）
  LOCAL_MEDIA_DIR    本地源目录（默认 ~/blog-media）
  VPS_CDN_DIR        VPS 分发目录（默认 /var/www/cdn）
  DEFAULT_MAX_WIDTH  --compress 时的最大宽度（默认 2000）

例子:
  # 加一张图（自动重命名 + 压缩 + 上传 + 输出 markdown）
  mediactl add ~/Downloads/IMG_4321.JPG --name iceland-aurora --compress

  # 加一个视频
  mediactl add ~/Movies/talk.mov --name climbing-101

  # 看本地有哪些图
  mediactl ls 2026/05

  # 全量同步
  mediactl sync
EOF
}

# ============================================================================
# 4. 入口
# ============================================================================

main() {
  local cmd="${1:-help}"
  case "$cmd" in
    add)         shift; cmd_add "$@" ;;
    sync)        shift; cmd_sync "$@" ;;
    preview)     shift; cmd_preview "$@" ;;
    prune)       shift; cmd_prune "$@" ;;
    ls)          shift; cmd_ls "$@" ;;
    url)         shift; cmd_url "$@" ;;
    help|--help|-h) cmd_help ;;
    *)           _die "未知子命令: $cmd
        跑 mediactl --help 看用法" ;;
  esac
}

main "$@"
