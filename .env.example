# 博客 / VPS 项目运维配置模板
# 复制为 .env 并填入真实值：cp .env.example .env

# === VPS ===
VPS_IP=                    # VPS 公网 IPv4
VPS_IPV6=                  # VPS 公网 IPv6
VPS_HOST=                  # SSH 别名（参考 ~/.ssh/config）
VPS_HOSTNAME=              # 服务器内部 hostname
VPS_INSTANCE_ID=           # Vultr / Hetzner 实例 ID

# === 域名 / Cloudflare ===
DOMAIN=                    # 主域名
CF_ZONE_ID=                # Cloudflare Zone ID
CF_ACCOUNT_ID=             # Cloudflare Account ID
CF_EMAIL=                  # Cloudflare 注册邮箱

# === Vultr ===
VULTR_EMAIL=

# === Hetzner（备用）===
HETZNER_EMAIL=
HETZNER_PROJECT_ID=

# === SSH ===
SSH_KEY_PATH=              # 私钥文件路径
SSH_PUB_FINGERPRINT=       # 公钥指纹（用于校验）
